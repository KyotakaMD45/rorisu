# Le fichier recommandé pour les nouvelles installations est config.env.
# Cette copie reste disponible pour compatibilité avec les anciens déploiements.
BOT_NAME=RORISU
HANDLERS=.
SUDO=
PAIRING_METHOD=qr
SESSION_ID=0
AUTH_DIRECTORY=auth_info_baileys
DATABASE_URL=
STORAGE_FILE=data/store.json
LANGUAGE=fr
TZ=Europe/Paris
WARN_LIMIT=3
AUTO_STATUS=off
AUTO_STATUS_VIEW=off
SEND_READ=off
AUTO_UPDATE=off
API_MODE=false
API_KEY=
PORT=3000
API_WEBHOOK_URL=
API_PUBLIC_URL=
EXTERNAL_PLUGINS_DIRECTORY=eplugins
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_SYSTEM_PROMPT=Tu es RORISU, un assistant utile. Réponds dans la langue de la question.
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_CONTEXT_TURNS=4
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_MEDIA_BYTES=10485760
